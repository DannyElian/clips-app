{
  "name": "clips-app",
  "version": "0.1.0",
  "description": "MVP: auto-find gameplay highlights and export vertical dual-layout (cam top / game bottom) TikTok clips",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "sample": "bash scripts/make-sample.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "clips",
    "ffmpeg",
    "tiktok",
    "vod",
    "highlights"
  ],
  "author": "Clips Project",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
